{
  "name": "restaurante-reservas-server",
  "version": "1.0.0",
  "description": "API REST do sistema de reservas para restaurante (Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:reset": "node scripts/setup-db.js --reset",
    "test": "node --test tests/rules.test.js tests/api.integration.test.js",
    "test:unit": "node --test tests/rules.test.js",
    "test:api": "node --test tests/api.integration.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
