# Porta da API
PORT=3001

# ---- Opção A: PostgreSQL local ------------------------------------------------
# postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/restaurante_reservas
DB_SSL=false

# ---- Opção B: Supabase (use a "Session pooler" da tela Connect) ---------------
# DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# DB_SSL=true
# (não coloque ?sslmode=... na URL; se a senha tiver @ # / : codifique-os, ex.: @ vira %40)

# Origem(ns) do frontend permitidas pelo CORS (separe várias por vírgula)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Regras do restaurante
MAX_PESSOAS_POR_HORARIO=30
MAX_PESSOAS_POR_RESERVA=12
HORARIO_ABERTURA=11:00
HORARIO_ULTIMA_RESERVA=22:00
INTERVALO_MINUTOS=30
FUSO_HORARIO=America/Sao_Paulo
